{
  "name": "janus-idp",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:seed": "dotenv -e .env -- prisma db seed",
    "prisma:studio": "dotenv -e .env -- prisma studio",
    "prisma:reset": "dotenv -e .env -- prisma migrate reset",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcus-v-rodrigues/janus-idp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/marcus-v-rodrigues/janus-idp/issues"
  },
  "homepage": "https://github.com/marcus-v-rodrigues/janus-idp#readme",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "oidc-provider": "^9.6.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.0",
    "@types/oidc-provider": "^9.5.0",
    "@types/pg": "^8.16.0",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.11",
    "prisma": "7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
