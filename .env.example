APP_PORT=3000
NODE_ENV=development

POSTGRES_USER=janus_admin
POSTGRES_PASSWORD=123_senha_segura
POSTGRES_DB=janus_db
POSTGRES_PORT=5432
POSTGRES_HOST=janus-db

# DATABASE_URL para conexão dentro do Docker (host='janus-db' = nome do serviço no docker-compose)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# OIDC Configuration
ISSUER_URL=http://localhost:3000/oidc

# Admin User Configuration - Usado pelo seed para criar o usuário admin
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# Test Client (OIDC Debugger) - Usado apenas pelo seed para criar o cliente no banco
OIDC_CLIENT_ID=test_client
OIDC_CLIENT_SECRET=test_secret
OIDC_REDIRECT_URIS=https://oidcdebugger.com/debug

# ux-auditor Client Configuration - Usado apenas pelo seed para criar o cliente no banco
UX_CLIENT_ID=ux-auditor
UX_CLIENT_SECRET=your_client_secret_here_change_in_production
UX_BASE_DOMAIN=dashboard.seudominio.com

# Cookie Keys (lista separada por vírgulas de chaves para assinatura de cookies)
COOKIE_KEYS=uma_chave_secreta_para_dev_1,uma_chave_secreta_para_dev_2

# Chaves RSA para assinatura RS256 (opcional - chaves serão geradas automaticamente se não fornecidas)
# Em produção, defina estas variáveis de ambiente com suas chaves no formato PEM
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Chave de API para autenticação de serviços externos (usada no header X-Service-Key)
JANUS_SERVICE_API_KEY=your_service_api_key_here_change_in_production

