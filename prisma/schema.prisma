generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OidcPayload {
  id         String    @id
  type       String
  payload    Json
  grantId    String?
  userCode   String?   @unique
  uid        String?   @unique
  expiresAt  DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([type])
  @@index([grantId])
}

model Client {
  id            String   @id @default(uuid())
  clientId      String   @unique
  clientSecret  String
  name          String?  // Nome amigável (ex: 'Meu App CRM')
  redirectUris  String[] // Postgres suporta arrays nativamente
  grantTypes    String[] @default(["authorization_code", "refresh_token"])
  responseTypes String[] @default(["code"])
  scope         String?  @default("openid profile email")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}